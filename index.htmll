<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Will you still be my best friend❤️‍🔥</title>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: linear-gradient(135deg, #180325, #4a0847, #180325);
      color: white;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      overflow: hidden;
    }
    .container {
      width: 100%;
      max-width: 400px;
      padding: 20px;
    }
    h1 {
      font-size: 1.8rem;
      font-weight: 900;
      letter-spacing: 1.5px;
      margin-bottom: 25px;
      text-transform: uppercase;
      text-shadow: 0 0 15px rgba(255, 105, 180, 0.6);
    }
    .media-card {
      width: 230px;
      height: 320px;
      border-radius: 30px;
      overflow: hidden;
      margin: 0 auto 30px auto;
      border: 3px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), 0 0 20px rgba(255, 75, 110, 0.4);
      background-color: #000;
    }
    .media-card video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .btn {
      background: linear-gradient(45deg, #ff2a5f, #ff758c);
      color: white;
      border: none;
      padding: 16px 45px;
      font-size: 1.2rem;
      font-weight: bold;
      border-radius: 35px;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(255, 42, 95, 0.5);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn:active {
      transform: scale(0.95);
    }
    .subtitle {
      font-size: 0.85rem;
      letter-spacing: 4px;
      text-transform: uppercase;
      opacity: 0.8;
      margin-bottom: 12px;
    }
    .hidden { 
      display: none; 
    }
  </style>
</head>
<body>

  <!-- 1-SAHIFA: Video va tugma -->
  <div id="page1" class="container">
    <h1>TUK-TUK-TUK<br>OPEN THE DOOR!</h1>
    <div class="media-card">
      <video id="myVideo" autoplay loop muted playsinline>
        <source src="3d92617870454f6f95a19dbc3efed1a9.mov" type="video/quicktime">
        <source src="3d92617870454f6f95a19dbc3efed1a9.mov" type="video/mp4">
        Sizning brauzeringiz videoni qo'llab-quvvatlamaydi.
      </video>
    </div>
    <button class="btn" onclick="nextPage()">Wait ...</button>
  </div>

  <!-- 2-SAHIFA: Savol qismi -->
  <div id="page2" class="container hidden">
    <div class="subtitle">ONE QUESTION</div>
    <h1>Will you still be my best friend❤️‍🔥</h1>
    <button class="btn" onclick="alert('Of course! ❤️✨')">YES</button>
  </div>

  <script>
    function nextPage() {
      document.getElementById('page1').classList.add('hidden');
      document.getElementById('page2').classList.remove('hidden');
    }
  </script>
</body>
</html>
